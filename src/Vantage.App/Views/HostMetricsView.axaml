<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Vantage.App.ViewModels"
             xmlns:controls="clr-namespace:Vantage.App.Controls"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="Vantage.App.Views.HostMetricsView"
             x:DataType="vm:HostViewModel"
             x:CompileBindings="True">

  <Grid RowDefinitions="Auto,*" Margin="4">

    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
      <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
      <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
        <TextBlock Text="{Binding StatusText}" FontSize="12" />
      </Border>
      <TextBlock Text="{Binding Endpoint}" Foreground="#8891A0" VerticalAlignment="Center" />
    </StackPanel>

    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*" >

      <Border Grid.Row="0" Grid.Column="0" Classes="card" Margin="0,0,6,12">
        <StackPanel Spacing="8">
          <DockPanel>
            <TextBlock Text="CPU" FontWeight="SemiBold" DockPanel.Dock="Left" />
            <TextBlock Text="{Binding CpuUsagePercent, StringFormat='{}{0:0.0} %'}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" />
          </DockPanel>
          <ProgressBar Maximum="100" Value="{Binding CpuUsagePercent}" Height="6" />
          <controls:SparklineControl Values="{Binding CpuPoints}" Maximum="100" Height="52"
                                     Stroke="{DynamicResource AccentBrush}" Fill="#1A4FC3F7" />
        </StackPanel>
      </Border>

      <Border Grid.Row="0" Grid.Column="1" Classes="card" Margin="6,0,0,12">
        <StackPanel Spacing="8">
          <DockPanel>
            <TextBlock Text="Memory" FontWeight="SemiBold" DockPanel.Dock="Left" />
            <TextBlock Text="{Binding MemoryUsedPercent, StringFormat='{}{0:0.0} %'}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" />
          </DockPanel>
          <ProgressBar Maximum="100" Value="{Binding MemoryUsedPercent}" Height="6" />
          <controls:SparklineControl Values="{Binding MemoryPoints}" Maximum="100" Height="52"
                                     Stroke="#66BB6A" Fill="#1A66BB6A" />
          <TextBlock Text="{Binding MemoryText}" Foreground="#8891A0" FontSize="12" />
        </StackPanel>
      </Border>

      <Border Grid.Row="1" Grid.Column="0" Classes="card" Margin="0,0,6,12">
        <StackPanel Spacing="8">
          <DockPanel>
            <TextBlock Text="Disk" FontWeight="SemiBold" DockPanel.Dock="Left" />
            <TextBlock Text="{Binding DiskUsedPercent, StringFormat='{}{0:0.0} %'}" HorizontalAlignment="Right" />
          </DockPanel>
          <ProgressBar Maximum="100" Value="{Binding DiskUsedPercent}" Height="6" />
          <TextBlock Text="{Binding DiskText}" Foreground="#8891A0" FontSize="12" />
        </StackPanel>
      </Border>

      <Border Grid.Row="1" Grid.Column="1" Classes="card" Margin="6,0,0,12">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Load" FontWeight="SemiBold" Width="70" />
            <TextBlock Text="{Binding LoadText}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Uptime" FontWeight="SemiBold" Width="70" />
            <TextBlock Text="{Binding UptimeText}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Classes="card"
              IsVisible="{Binding LastError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="{Binding LastError}" Foreground="{DynamicResource DownBrush}" TextWrapping="Wrap" />
      </Border>

    </Grid>
  </Grid>
</UserControl>
