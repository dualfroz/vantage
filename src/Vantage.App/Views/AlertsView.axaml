<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Vantage.App.ViewModels"
             xmlns:conv="clr-namespace:Vantage.App.Converters"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="Vantage.App.Views.AlertsView"
             x:DataType="vm:MainWindowViewModel"
             x:CompileBindings="True">

  <Grid RowDefinitions="Auto,3*,Auto,2*" Margin="4">

    <TextBlock Grid.Row="0" Margin="2,0,0,8" Foreground="#8891A0" FontSize="12"
               Text="{Binding FiringAlertCount, StringFormat='Firing: {0}'}" />

    <Border Grid.Row="1" Classes="card">
      <Grid>
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Alerts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AlertRowViewModel">
                <Grid ColumnDefinitions="Auto,2*,2*,Auto" Margin="0,7">
                  <Border Grid.Column="0" Width="4" Margin="0,0,12,0" CornerRadius="2"
                          Background="{Binding Tone, Converter={x:Static conv:StateBrushConverters.ToneBrush}}" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RuleName}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding HostName}" Foreground="#8891A0" FontSize="11" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ConditionText}" />
                    <TextBlock Foreground="#8891A0" FontSize="11" Text="{Binding ValueText}" />
                  </StackPanel>
                  <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding StateText}" HorizontalAlignment="Right" FontWeight="SemiBold"
                               Foreground="{Binding Tone, Converter={x:Static conv:StateBrushConverters.ToneBrush}}" />
                    <TextBlock Foreground="#8891A0" FontSize="11" HorizontalAlignment="Right">
                      <Run Text="{Binding SeverityText}" />
                      <Run Text="{Binding SinceText}" />
                    </TextBlock>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasNoAlerts}"
                   Text="No alert rule has been evaluated yet. Rules are checked against every host after each poll." />
      </Grid>
    </Border>

    <TextBlock Grid.Row="2" Margin="2,14,0,8" Foreground="#8891A0" FontSize="12" Text="Recent transitions" />

    <Border Grid.Row="3" Classes="card">
      <Grid>
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding RecentTransitions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AlertTransitionViewModel">
                <Grid ColumnDefinitions="70,80,2*,3*" Margin="0,4">
                  <TextBlock Grid.Column="0" Text="{Binding TimeText}" Foreground="#8891A0" />
                  <TextBlock Grid.Column="1" Text="{Binding KindText}" FontWeight="SemiBold"
                             Foreground="{Binding Tone, Converter={x:Static conv:StateBrushConverters.ToneBrush}}" />
                  <TextBlock Grid.Column="2" TextTrimming="CharacterEllipsis" Margin="0,0,10,0">
                    <Run Text="{Binding RuleName}" FontWeight="SemiBold" />
                    <Run Text="{Binding HostName}" Foreground="#8891A0" />
                  </TextBlock>
                  <TextBlock Grid.Column="3" Text="{Binding DetailText}" Foreground="#8891A0" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasNoTransitions}"
                   Text="Alerts that fire or resolve while Vantage is running are listed here." />
      </Grid>
    </Border>

  </Grid>
</UserControl>
