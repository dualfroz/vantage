<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Vantage.App.ViewModels"
             xmlns:conv="clr-namespace:Vantage.App.Converters"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="Vantage.App.Views.SystemdView"
             x:DataType="vm:SystemdViewModel"
             x:CompileBindings="True">

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="4">

    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="0,0,0,8">
      <Button Grid.Column="0" Content="Refresh" Command="{Binding RefreshCommand}" />
      <ComboBox Grid.Column="1" Margin="12,0,0,0" MinWidth="120"
                ItemsSource="{Binding StateFilters}" SelectedItem="{Binding SelectedStateFilter}" />
      <TextBox Grid.Column="2" Width="220" Margin="8,0,0,0" Text="{Binding FilterText}"
               Watermark="Filter by unit or description" />
      <TextBlock Grid.Column="3" Text="{Binding LastError}" Classes="error" Margin="12,0" VerticalAlignment="Center"
                 TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                 IsVisible="{Binding LastError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Grid.Column="4" Classes="caption" Text="{Binding LoadedAtText}" VerticalAlignment="Center" />
    </Grid>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="22" Margin="2,0,0,10" IsVisible="{Binding HasLoaded}">
      <StackPanel>
        <TextBlock Classes="muted" Text="Services" />
        <TextBlock Text="{Binding TotalCount}" FontSize="18" FontWeight="Bold" />
      </StackPanel>
      <StackPanel>
        <TextBlock Classes="muted" Text="Running" />
        <TextBlock Text="{Binding RunningCount}" FontSize="18" FontWeight="Bold" Foreground="#4CAF50" />
      </StackPanel>
      <StackPanel>
        <TextBlock Classes="muted" Text="Failed" />
        <TextBlock Text="{Binding FailedCount}" FontSize="18" FontWeight="Bold" Foreground="#EF5350" />
      </StackPanel>
      <StackPanel>
        <TextBlock Classes="muted" Text="Inactive" />
        <TextBlock Text="{Binding InactiveCount}" FontSize="18" FontWeight="Bold" />
      </StackPanel>
    </StackPanel>

    <Border Grid.Row="2" Classes="card" Padding="6,10">
      <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="20,2*,1.2*,3*" Margin="8,0,8,6">
          <TextBlock Grid.Column="1" Classes="muted" Text="Unit" />
          <TextBlock Grid.Column="2" Classes="muted" Text="State" />
          <TextBlock Grid.Column="3" Classes="muted" Text="Description" />
        </Grid>
        <ListBox Grid.Row="1" Classes="table" ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedUnit}"
                 Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SystemdUnitViewModel">
              <Grid ColumnDefinitions="20,2*,1.2*,3*">
                <Ellipse Grid.Column="0" Width="9" Height="9" HorizontalAlignment="Left" VerticalAlignment="Center"
                         Fill="{Binding Tone, Converter={x:Static conv:StateBrushConverters.ToneBrush}}" />
                <TextBlock Grid.Column="1" Text="{Binding Unit}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                <TextBlock Grid.Column="2" Text="{Binding StateText}" Foreground="{Binding Tone, Converter={x:Static conv:StateBrushConverters.ToneBrush}}"
                           TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                <TextBlock Grid.Column="3" Text="{Binding Description}" Foreground="#8891A0" TextTrimming="CharacterEllipsis" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <Grid Grid.Row="3" Margin="0,10,0,0" RowDefinitions="Auto,Auto">
      <DockPanel Grid.Row="0" IsVisible="{Binding !IsConfirmingStop}">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" IsEnabled="{Binding HasSelection}">
          <Button Content="Start" Command="{Binding StartCommand}" />
          <Button Content="Restart" Command="{Binding RestartCommand}" />
          <Button Content="Stop" Classes="danger" Command="{Binding RequestStopCommand}" />
        </StackPanel>
        <TextBlock Classes="caption" Text="{Binding SummaryText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>

      <Border Grid.Row="0" Classes="confirm" IsVisible="{Binding IsConfirmingStop}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
            <Button Content="Stop service" Classes="danger" Command="{Binding ConfirmStopCommand}" />
            <Button Content="Cancel" Command="{Binding CancelStopCommand}" />
          </StackPanel>
          <TextBlock Text="{Binding ConfirmStopText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
        </DockPanel>
      </Border>

      <TextBlock Grid.Row="1" Classes="success" Margin="0,8,0,0" Text="{Binding StatusMessage}"
                 IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </Grid>

  </Grid>
</UserControl>
