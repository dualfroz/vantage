<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Vantage.App.App"
             RequestedThemeVariant="Dark">

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="BorderBrush" Value="#2C323D" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#8891A0" />
      <Setter Property="FontSize" Value="11" />
    </Style>

    <Style Selector="TextBlock.caption">
      <Setter Property="Foreground" Value="#8891A0" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="TextBlock.section">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource DownBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.success">
      <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, DejaVu Sans Mono, Liberation Mono" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="TextBlock.numeric">
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <Style Selector="Button.header">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0,2" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#8891A0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.header:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#D5DBE4" />
    </Style>
    <Style Selector="Button.header:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="Button.danger">
      <Setter Property="Foreground" Value="#FF8A80" />
    </Style>

    <Style Selector="ListBox.table ListBoxItem">
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style Selector="Border.confirm">
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="BorderBrush" Value="#5A4A22" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="AccentBrush" Color="#4FC3F7" />
      <SolidColorBrush x:Key="OkBrush" Color="#4CAF50" />
      <SolidColorBrush x:Key="WarnBrush" Color="#FFB300" />
      <SolidColorBrush x:Key="DownBrush" Color="#EF5350" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#1B1F27" />
      <SolidColorBrush x:Key="SurfaceAltBrush" Color="#232833" />
    </ResourceDictionary>
  </Application.Resources>

</Application>
